   "byte_budget": 8,
   "max_chars": 4
  },
  {
   "id": 73,
   "offset": 293064,
   "text_jp": "マ{204}ク:こんなうっと{204}し{204}トコもう注はねぇだろ?",
   "current_en": "Mark: We don't got any more business in a dreary place like this, do we?",
   "byte_budget": 30,
   "max_chars": 15
  },
  {
   "id": 74,
   "offset": 293096,
   "text_jp": "帛く神取ブチのめしに行こうぜ",
   "current_en": "Let's hurry up and go beat the crap outta Kandori!",
   "byte_budget": 19,
   "max_chars": 9
  },
  {
   "id": 75,
   "offset": 293152,
   "text_jp": "悃希:他の場斯に行くの?",
   "current_en": "Maki: Are we going somewhere else?",
   "byte_budget": 20,
   "max_chars": 10
  },
  {
   "id": 76,
   "offset": 293178,
   "text_jp": "みんなと",
   "current_en": "Unleash our full power!",
   "byte_budget": 4,
   "max_chars": 2
  },
  {
   "id": 77,
   "offset": 293236,
   "text_jp": "南茱:ここに入れるのは",
   "current_en": "Nanjo: The only ones who can enter here...",
   "byte_budget": 15,
   "max_chars": 7
  },
  {
   "id": 78,
   "offset": 293253,
   "text_jp": "お前と園忖だけのはずだろうが",
   "current_en": "should be you and Sonomura.",
   "byte_budget": 17,
   "max_chars": 8
  },
  {
   "id": 79,
   "offset": 293337,
   "text_jp": "入れないんだ",
   "current_en": "can't enter.",
   "byte_budget": 7,
   "max_chars": 3
  },
  {
   "id": 80,
   "offset": 293428,
   "text_jp": "嘩菫厘敷ブッ壞してセベクになってたんだよな?",
   "current_en": "They tore down the mansion and built SEBEC, right?",
   "byte_budget": 31,
   "max_chars": 15
  },
  {
   "id": 81,
   "offset": 293486,
   "text_jp": "タイムスリップなんか?",
   "current_en": "Did we time slip or something?",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 82,
   "offset": 293520,
   "text_jp": "悃希:こっちじゃ",
   "current_en": "Maki: In this world,",
   "byte_budget": 11,
   "max_chars": 5
  },
  {
   "id": 83,
   "offset": 293537,
   "text_jp": "こうだったけど…",
   "current_en": "it was like this, but...",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 84,
   "offset": 293596,
   "text_jp": "こんなトコ禾てる場合か?",
   "current_en": "Is this really the time to be coming to a place like this?!",
   "byte_budget": 16,
   "max_chars": 8
  },
  {
   "id": 85,
   "offset": 293614,
   "text_jp": "他にやるコトあんだろ?",
   "current_en": "Don't we have other things to do?!",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 86,
   "offset": 293664,
   "text_jp": "悃希:あの子は",
   "current_en": "Maki: That child...",
   "byte_budget": 11,
   "max_chars": 5
  },
  {
   "id": 87,
   "offset": 293677,
   "text_jp": "もうだいじょぶだよ",
   "current_en": "is alright now.",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 88,
   "offset": 293690,
   "text_jp": "帛くしないと!",
   "current_en": "We have to hurry!",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 89,
   "offset": 293840,
   "text_jp": "行くんじゃね{204}のかよ",
   "current_en": "Aren't we supposed to go?!",
   "byte_budget": 12,
   "max_chars": 6
  },
  {
   "id": 90,
   "offset": 293856,
   "text_jp": "南茱:街を申てどうする気だ?",
   "current_en": "Nanjo: What do you plan to do leaving the town?!",
   "byte_budget": 21,
   "max_chars": 10
  },
  {
   "id": 91,
   "offset": 293879,
   "text_jp": "痞畭に行くのだろうが",
   "current_en": "We are supposed to be going to the hospital!",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 92,
   "offset": 293920,
   "text_jp": "キレるよ",
   "current_en": "I'm gonna lose it.",
   "byte_budget": 4,
   "max_chars": 2
  },
  {
   "id": 93,
   "offset": 293926,
   "text_jp": "街申てどうする気だい!",
   "current_en": "What do you plan to do leaving the town?!",
   "byte_budget": 15,
   "max_chars": 7
  },
  {
   "id": 94,
   "offset": 293945,
   "text_jp": "まったく…",
   "current_en": "Wasted all that sympathy.",
   "byte_budget": 6,
   "max_chars": 3
  },
  {
   "id": 95,
   "offset": 294009,
   "text_jp": "どうする気だ?",
   "current_en": "What are you planning to do?",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 96,
   "offset": 294026,
   "text_jp": "街の東にいるんだぞ?",
   "current_en": "is to the east of town, you know?!",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 97,
   "offset": 294076,
   "text_jp": "マ{204}ク:オイオイオイオイオイ!フラフラしてる場合か?",
   "current_en": "Mark: Whoa-whoa-whoa! Is this really the time to be wandering around?!",
   "byte_budget": 32,
   "max_chars": 16
  },
  {
   "id": 98,
   "offset": 294110,
   "text_jp": "ゆ{204}ちょ{204}なヤツだな{204}!!",
   "current_en": "You're taking your sweet time, aren't ya?!",
   "byte_budget": 18,
   "max_chars": 9
  },
  {
   "id": 99,
   "offset": 294140,
   "text_jp": "そっちじゃね{204}ぞ",
   "current_en": "It's not that way!",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 100,
