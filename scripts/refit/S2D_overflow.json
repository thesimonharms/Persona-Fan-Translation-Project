   "text_jp": "おじさん:オ{204}マイガッ!",
   "current_en": "Middle-aged Man: Oh my God!",
   "byte_budget": 17,
   "max_chars": 8
  },
  {
   "id": 101,
   "offset": 294243,
   "text_jp": "入ると危ないぞ!",
   "current_en": "It's dangerous if you go in!",
   "byte_budget": 11,
   "max_chars": 5
  },
  {
   "id": 102,
