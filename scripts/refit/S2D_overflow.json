{
 "file": "S2D.BIN",
 "count": 112,
 "entries": [
  {
   "id": 3,
   "offset": 174138,
   "text_jp": "いざね",
   "current_en": "Well then.",
   "byte_budget": 3,
   "max_chars": 1
  },
  {
   "id": 4,
   "offset": 183902,
   "text_jp": "いざね",
   "current_en": "Well then.",
   "byte_budget": 3,
   "max_chars": 1
  },
  {
   "id": 6,
   "offset": 289970,
   "text_jp": "注があるのか?",
   "current_en": "Do you have business here?",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 7,
   "offset": 290056,
   "text_jp": "ゆきの:｜アラヤ神扎の由禾』…",
   "current_en": "Yukino: \"Origins of Araya Shrine\"...",
   "byte_budget": 23,
   "max_chars": 11
  },
  {
   "id": 8,
   "offset": 290091,
   "text_jp": "人の沚の宇に任む",
   "current_en": "Residing within the hearts of humanity,",
   "byte_budget": 12,
   "max_chars": 6
  },
  {
   "id": 9,
   "offset": 290109,
   "text_jp": "まつったものです』",
   "current_en": "is what is enshrined here.\"",
   "byte_budget": 10,
   "max_chars": 5
  },
  {
   "id": 10,
   "offset": 290121,
   "text_jp": "だってさ",
   "current_en": "or so it says.",
   "byte_budget": 4,
   "max_chars": 2
  },
  {
   "id": 11,
   "offset": 290154,
   "text_jp": "変な名前ね!",
   "current_en": "What a strange name!",
   "byte_budget": 10,
   "max_chars": 5
  },
  {
   "id": 12,
   "offset": 290176,
   "text_jp": "あるのかなぁ?",
   "current_en": "I wonder if there is...?",
   "byte_budget": 8,
   "max_chars": 4
  },
  {
   "id": 13,
   "offset": 290347,
   "text_jp": "されてねぇんだ",
   "current_en": "hasn't been done.",
   "byte_budget": 7,
   "max_chars": 3
  },
  {
   "id": 14,
   "offset": 290373,
   "text_jp": "見るモンがねぇって話だぜ",
   "current_en": "They say there's nothing to see.",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 15,
   "offset": 290407,
   "text_jp": "入れなかったっけ…",
   "current_en": "Couldn't we go inside...?",
   "byte_budget": 11,
   "max_chars": 5
  },
  {
   "id": 16,
   "offset": 290451,
   "text_jp": "愴跡があるのに",
   "current_en": "Even though there are ruins,",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 17,
   "offset": 290467,
   "text_jp": "入れないんですものね",
   "current_en": "we still can't enter, can we?",
   "byte_budget": 11,
   "max_chars": 5
  },
  {
   "id": 18,
   "offset": 290576,
   "text_jp": "逃げるつもり?",
   "current_en": "Are you trying to run away?",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 19,
   "offset": 290609,
   "text_jp": "怒られるよ!",
   "current_en": "You're gonna get yelled at!",
   "byte_budget": 8,
   "max_chars": 4
  },
  {
   "id": 20,
   "offset": 290646,
   "text_jp": "逃げるつもりか?",
   "current_en": "Are you planning to run?",
   "byte_budget": 10,
   "max_chars": 5
  },
  {
   "id": 21,
   "offset": 290720,
   "text_jp": "閉まっている…",
   "current_en": "It's closed...",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 22,
   "offset": 290883,
   "text_jp": "思ったとおり",
   "current_en": "Just as I thought,",
   "byte_budget": 7,
   "max_chars": 3
  },
  {
   "id": 23,
   "offset": 290903,
   "text_jp": "逃げることはできんということだ",
   "current_en": "it means running away is not an option.",
   "byte_budget": 16,
   "max_chars": 8
  },
  {
   "id": 24,
   "offset": 291021,
   "text_jp": "申してくれよ!",
   "current_en": "Let me out!",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 25,
   "offset": 291057,
   "text_jp": "肪けてくれよォ{204}!",
   "current_en": "Save meee!",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 26,
   "offset": 291108,
   "text_jp": "閉まっている…",
   "current_en": "It's closed...",
   "byte_budget": 9,
   "max_chars": 4
  },
  {
   "id": 27,
   "offset": 291201,
   "text_jp": "達れて行かなくては!",
   "current_en": "We have to take them with us!",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 28,
   "offset": 291264,
   "text_jp": "化している…",
   "current_en": "has transformed...",
   "byte_budget": 8,
   "max_chars": 4
  },
  {
   "id": 29,
   "offset": 291307,
   "text_jp": "アンちゃんらと",
   "current_en": "with those big bros",
   "byte_budget": 7,
   "max_chars": 3
  },
  {
   "id": 30,
   "offset": 291345,
   "text_jp": "入っていったぞ",
   "current_en": "went inside!",
   "byte_budget": 8,
   "max_chars": 4
  },
  {
   "id": 31,
   "offset": 291394,
   "text_jp": "閉ざされている…",
   "current_en": "It's sealed shut...",
   "byte_budget": 10,
   "max_chars": 5
  },
  {
   "id": 32,
   "offset": 291451,
   "text_jp": "ここが警察か?",
   "current_en": "Is this the police station?",
   "byte_budget": 10,
   "max_chars": 5
  },
  {
   "id": 33,
   "offset": 291463,
   "text_jp": "定談は顔だけにしろ!",
   "current_en": "Keep the jokes to your face!",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 34,
   "offset": 291583,
   "text_jp": "こんな薄角い場斯に",
   "current_en": "In a dark and gloomy place like this,",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 35,
   "offset": 291598,
   "text_jp": "注は無いはずだろう?",
   "current_en": "you shouldn't have any business, right?",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 36,
   "offset": 291627,
   "text_jp": "てんめぇ…",
   "current_en": "You bastard...",
   "byte_budget": 6,
   "max_chars": 3
  },
  {
   "id": 37,
   "offset": 291656,
   "text_jp": "本当にフラフラすんのが好きなんだね",
   "current_en": "You really love wandering around aimlessly, don't ya?",
   "byte_budget": 20,
   "max_chars": 10
  },
  {
   "id": 38,
   "offset": 291684,
   "text_jp": "時と場斯を選びな!",
   "current_en": "Pick the right time and place!",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 39,
   "offset": 291700,
   "text_jp": "ったく…",
   "current_en": "Sheesh...",
   "byte_budget": 5,
   "max_chars": 2
  },
  {
   "id": 40,
   "offset": 291752,
   "text_jp": "黒服の女:ここから旡は",
   "current_en": "Woman in Black: Beyond here...",
   "byte_budget": 16,
   "max_chars": 8
  },
  {
   "id": 41,
   "offset": 291770,
   "text_jp": "セベクの管理下だ!",
   "current_en": "is under SEBEC's jurisdiction!",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 42,
   "offset": 291786,
   "text_jp": "僵行は禁止されている!",
   "current_en": "Passage is strictly prohibited!",
   "byte_budget": 16,
   "max_chars": 8
  },
  {
   "id": 43,
   "offset": 291818,
   "text_jp": "えらそうにぃ!",
   "current_en": "Acting so high and mighty!",
   "byte_budget": 8,
   "max_chars": 4
  },
  {
   "id": 44,
   "offset": 291832,
   "text_jp": "アッタマきちゃう!",
   "current_en": "That really ticks me off!",
   "byte_budget": 11,
   "max_chars": 5
  },
  {
   "id": 45,
   "offset": 291849,
   "text_jp": "みんな!イ{214}ッダ!",
   "current_en": "Everyone, let's go~!",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 46,
   "offset": 291964,
   "text_jp": "お埴じゃなかった…?",
   "current_en": "Wasn't it a shrine...?",
   "byte_budget": 13,
   "max_chars": 6
  },
  {
   "id": 47,
   "offset": 292030,
   "text_jp": "記蟷軣失なのかよ?",
   "current_en": "Did you lose your memory?!",
   "byte_budget": 14,
   "max_chars": 7
  },
  {
   "id": 48,
   "offset": 292069,
   "text_jp": "なんかそんな気がしてきた!",
   "current_en": "I'm starting to feel that way too!",
   "byte_budget": 15,
   "max_chars": 7
  },
  {
   "id": 49,
   "offset": 292088,
   "text_jp": "帛く行こ!",
   "current_en": "Let's hurry and go!",
   "byte_budget": 8,
   "max_chars": 4
  },
